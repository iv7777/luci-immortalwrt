msgstr "错误：%s"

msgid "Run Network Check"
msgstr "运行网络检测"

msgid "choose a device"
msgstr "选择设备"

msgid "offline"
msgstr "离线"

msgid "or enter a Tailscale IP / device name"
msgstr "或输入 Tailscale IP / 设备名称"

msgid "Choose a device or enter a target first."
msgstr "请先选择设备或输入目标。"

msgid "Ping"
msgstr "Ping"

msgid "Tailscale Diagnostics"
msgstr "Tailscale 诊断"

msgid "Network Check"
msgstr "网络检测"

msgid "Tests UDP connectivity, NAT behaviour and the latency to the Tailscale relay servers. It takes a few seconds. A direct connection between devices needs working UDP."
msgstr "检测 UDP 连通性、NAT 行为以及到 Tailscale 中继服务器的延迟，需要几秒钟。设备之间要建立直连，需要 UDP 可用。"

msgid "Pings a device through Tailscale and shows whether the path is direct or goes through a relay."
msgstr "通过 Tailscale 对设备执行 Ping，并显示链路是直连还是经过中继。"

msgid "No Tailscale log entries yet."
msgstr "暂无 Tailscale 日志。"

msgid "The \"tailscale_plus\" service of rpcd is missing. Check \"logread -e rpcd\" for errors and run \"/etc/init.d/rpcd restart\"."
msgstr "rpcd 的“tailscale_plus”服务不存在。请用“logread -e rpcd”查看错误，并执行“/etc/init.d/rpcd restart”。"

msgid "Scroll to end"
msgstr "滚动到末尾"

msgid "Scroll to top"
msgstr "滚动到顶部"

msgid "Tailscale Logs"
msgstr "Tailscale 日志"

msgid "The most recent Tailscale messages from the system log. This page refreshes automatically."
msgstr "系统日志中最近的 Tailscale 消息。本页会自动刷新。"

msgid "Just now"
msgstr "刚刚"

msgid "%d min ago"
msgstr "%d 分钟前"

msgid "%d h ago"
msgstr "%d 小时前"

msgid "Collecting data ..."
msgstr "正在收集数据…"

msgid "Service Status"
msgstr "服务状态"

msgid "BACKEND NOT AVAILABLE"
msgstr "后端不可用"

msgid "TAILSCALE NOT FOUND"
msgstr "未找到 TAILSCALE"

msgid "DISABLED"
msgstr "已禁用"

msgid "Tailscale is switched off. Enable it in the settings below, then click \"Save & Apply\"."
msgstr "Tailscale 已关闭。请在下方设置中启用，然后点击“保存并应用”。"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "STARTING"
msgstr "正在启动"

msgid "STOPPED"
msgstr "已停止"

msgid "Tailscale is installed but turned down (\"tailscale down\")."
msgstr "Tailscale 已安装但处于关闭状态（“tailscale down”）。"

msgid "LOGGED OUT"
msgstr "已登出"

msgid "Use the Login button in the \"Account\" tab to authenticate this device."
msgstr "请使用“账户”选项卡中的登录按钮验证此设备。"

msgid "WAITING FOR APPROVAL"
msgstr "等待批准"

msgid "An administrator has to approve this device in the Tailscale admin console."
msgstr "管理员需要在 Tailscale 管理控制台中批准此设备。"

msgid "UNKNOWN"
msgstr "未知"

msgid "RUNNING"
msgstr "运行中"

