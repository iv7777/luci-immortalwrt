msgstr "已启用"

msgid "Disabled"
msgstr "已禁用"

msgid "Key Expires"
msgstr "密钥到期"

msgid "Using Exit Node"
msgstr "正在使用出口节点"

msgid "Health Check"
msgstr "健康检查"

msgid "Direct"
msgstr "直连"

msgid "Relay"
msgstr "中继"

msgid "Tailscale is not running."
msgstr "Tailscale 未运行。"

msgid "No peer devices found."
msgstr "未找到对等设备。"

msgid "Status"
msgstr "状态"

msgid "Hostname"
msgstr "主机名"

msgid "Tailscale IP"
msgstr "Tailscale IP"

msgid "OS"
msgstr "操作系统"

msgid "Connection"
msgstr "连接"

msgid "RX"
msgstr "接收"

msgid "TX"
msgstr "发送"

msgid "Last Seen"
msgstr "最后在线"

